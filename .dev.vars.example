# ローカル開発用のサーバー側シークレット（`cp .dev.vars.example .dev.vars`）。
# 本番は `npx wrangler secret put <NAME>` で同じ名前を登録する。
# 公開値（SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / APP_URL）は wrangler.jsonc の vars にある。

# Supabase（全権限キー。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 決済
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# メール送信
RESEND_API_KEY=

# プッシュ通知の秘密鍵（公開鍵は wrangler.jsonc の VAPID_PUBLIC_KEY）
VAPID_PRIVATE_KEY=

# TikTok 動画づくり（GitHub Actions との合言葉。GitHub の Secrets にも同じ値）
STUDIO_SECRET=
