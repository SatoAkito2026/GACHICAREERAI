// 会社ホームページ（akitogroup.jp）
// public/ のページ・画像をそのまま配信し、worker/index.js でお問い合わせフォームと旧URLの転送を受け持つ
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "akitogroup-site",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // 毎日 9:05（日本時間）にモニターの「契約が切れる前のお知らせ」を送る。SUPABASE_URL はポスポス用のプロジェクト（pospos・東京）
  "triggers": { "crons": ["5 0 * * *"] },
  "vars": { "SUPABASE_URL": "https://adzoyzslrjaokovqhxol.supabase.co" }
}
